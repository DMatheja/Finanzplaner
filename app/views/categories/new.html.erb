<h2>New Category</h2>
<form method="post" action="<%= categories_path %>">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
  
  <label>Name:</label>
  <input type="text" name="category[name]" required>
  
  <label>Limit (optional):</label>
  <input type="number" step="0.01" name="category[limit]">
  
  <button type="submit">Create</button>
  <a href="<%= categories_path %>"><button type="button">Cancel</button></a>
</form>

<h2>Edit Category</h2>
<form method="post" action="<%= category_path(@category) %>">
  <input type="hidden" name="_method" value="patch">
  <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
  
  <label>Name:</label>
  <input type="text" name="category[name]" value="<%= @category.name %>" required>
  
  <label>Limit (optional):</label>
  <input type="number" step="0.01" name="category[limit]" value="<%= @category.limit %>">
  
  <button type="submit">Update</button>
  <a href="<%= category_path(@category) %>"><button type="button">Cancel</button></a>
</form>

<h2>Expenses</h2>
<table>
  <tr>
    <th>Date</th>
    <th>Product</th>
    <th>Category</th>
    <th>Amount</th>
  </tr>
  <% @transactions.each do |transaction| %>
    <tr>
      <td><%= transaction.transaction_date.strftime('%d.%m.%Y') %></td>
      <td><%= transaction.product.name %></td>
      <td><%= transaction.product.category.name %></td>
      <td>€<%= number_with_precision(transaction.amount, precision: 2) %></td>
    </tr>
  <% end %>
</table>
<p><strong>Total:</strong> €<%= number_with_precision(@transactions.sum(:amount), precision: 2) %></p>
<br>
<a href="<%= products_path %>"><button>Back to Products</button></a>

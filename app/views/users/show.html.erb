<h2><%= @user.name %></h2>
<p><strong>Email:</strong> <%= @user.email %></p>
<p><strong>Role:</strong> <%= @user.role.titleize %></p>
<p><strong>Current Balance:</strong> €<%= number_with_precision(@user.balance, precision: 2) %></p>
<br>
<a href="<%= edit_user_path(@user) %>"><button>Edit</button></a>
<% if current_user.admin? && current_user.id != @user.id %>
  <a href="<%= user_path(@user) %>" data-method="delete"><button>Delete</button></a>
<% end %>
<a href="<%= users_path %>"><button>Back</button></a>

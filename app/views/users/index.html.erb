<h2>Users</h2>
<table>
  <tr>
    <th>Name</th>
    <th>Email</th>
    <th>Role</th>
    <th>Actions</th>
  </tr>
  <% @users.each do |user| %>
    <tr>
      <td><%= user.name %></td>
      <td><%= user.email %></td>
      <td><%= user.role.titleize %></td>
      <td>
        <a href="<%= user_path(user) %>">View</a>
        <a href="<%= edit_user_path(user) %>">Edit</a>
        <a href="<%= user_path(user) %>" data-method="delete">Delete</a>
      </td>
    </tr>
  <% end %>
</table>
<br>
<a href="<%= new_user_path %>"><button>New User</button></a>

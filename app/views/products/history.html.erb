<div style="max-width: 1200px; margin: 40px auto; padding: 30px;">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h1 style="margin: 0;">Product Purchase History</h1>
    <%= link_to "← Back to Products", products_path, style: "color: #0066cc; text-decoration: none; font-size: 14px;" %>
  </div>

  <% if @products.any? %>
    <div style="background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
      <table style="width: 100%; border-collapse: collapse;">
        <thead>
          <tr style="background: #f5f5f5; border-bottom: 2px solid #ddd;">
            <th style="padding: 15px; text-align: left; font-weight: bold;">Product</th>
            <th style="padding: 15px; text-align: left; font-weight: bold;">Category</th>
            <th style="padding: 15px; text-align: right; font-weight: bold;">Price</th>
            <th style="padding: 15px; text-align: right; font-weight: bold;">Amount</th>
            <th style="padding: 15px; text-align: right; font-weight: bold;">Total</th>
            <th style="padding: 15px; text-align: left; font-weight: bold;">Purchased</th>
            <th style="padding: 15px; text-align: center; font-weight: bold;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr style="border-bottom: 1px solid #eee;">
              <td style="padding: 15px;"><strong><%= product.name %></strong></td>
              <td style="padding: 15px;"><%= product.category.name %></td>
              <td style="padding: 15px; text-align: right;">€<%= number_with_precision(product.price, precision: 2) %></td>
              <td style="padding: 15px; text-align: right;"><%= product.amount %></td>
              <td style="padding: 15px; text-align: right;">€<%= number_with_precision(product.price * product.amount, precision: 2) %></td>
              <td style="padding: 15px; font-size: 12px; color: #666;">
                <%= product.purchased_at.strftime("%d.%m.%Y %H:%M") if product.purchased_at %>
              </td>
              <td style="padding: 15px; text-align: center;">
                <%= button_to "🔄 Repurchase", repurchase_product_path(product), method: :post, form: { style: "display: inline; margin: 0;" }, style: "color: #28a745; background: #e8f5e9; border: none; border-radius: 4px; padding: 6px 12px; font-size: 12px; cursor: pointer;" %>
                <%= link_to "📖 View", product_path(product), style: "color: #0066cc; text-decoration: none; font-size: 12px; padding: 6px 12px; background: #e3f2fd; border-radius: 4px; display: inline-block; margin-left: 5px;" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div style="background: #f0f0f0; border-radius: 12px; padding: 40px; text-align: center; color: #666;">
      <p style="margin: 0; font-size: 16px;">No products in history yet.</p>
      <p style="margin: 10px 0 0 0; font-size: 14px;">Mark products as purchased to see them here.</p>
    </div>
  <% end %>
</div>
